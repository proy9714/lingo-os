# Copy this file to .env and fill in what you use. .env is git-ignored.
# Only API keys live here; model choices live in config/llm.yaml (and in Settings → AI explanations).
# One key is enough. You can also paste keys in Settings, which saves them here.

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# ChatGPT: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: move all personal data (database, library, recordings) elsewhere.
# LINGO_DATA_DIR=D:/lingo-data

# ---- Running Lingo OS on a server (docs/DEPLOY.md). Leave these out on a laptop. ----
# Listen beyond this computer (a server on Tailscale: its Tailscale IP, or 0.0.0.0 behind `tailscale serve`).
# LINGO_HOST=127.0.0.1
# LINGO_PORT=8787
# The address your phone and browser use (phones are told it when they pair); phones then sync on this port too.
# LINGO_PUBLIC_URL=https://lingo.tail1234.ts.net
# Ask for this token once per browser before anything answers (anyone who can reach the server otherwise could).
# LINGO_ACCESS_TOKEN=
# YouTube often refuses cloud servers: a cookies.txt exported from a browser signed in to YouTube, and/or a proxy.
# LINGO_YTDLP_COOKIES=/data/youtube-cookies.txt
# LINGO_YTDLP_PROXY=socks5://100.101.102.103:1080
