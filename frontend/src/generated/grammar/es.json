       "ella"
      ],
      [
       "you (formal)",
       "usted",
       "lo / la",
       "le",
       "usted"
      ],
      [
       "we / us",
       "nosotros / nosotras",
       "nos",
       "nos",
       "nosotros"
      ],
      [
       "you all (Spain, informal)",
       "vosotros / vosotras",
       "os",
       "os",
       "vosotros"
      ],
      [
       "they / you all",
       "ellos / ellas / ustedes",
