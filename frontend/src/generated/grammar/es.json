       "dormimos",
       "pedimos"
      ],
      [
       "vosotros",
       "pensáis",
       "dormís",
       "pedís"
      ],
      [
       "ellos / ustedes",
       "p{ie}nsan",
       "d{ue}rmen",
       "p{i}den"
      ]
     ]
    }
   ],
