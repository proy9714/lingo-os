       "com{o}",
       "viv{o}"
      ],
      [
       "tú",
       "habl{as}",
       "com{es}",
       "viv{es}"
      ],
      [
       "él / ella / usted",
       "habl{a}",
       "com{e}",
       "viv{e}"
      ],
      [
       "nosotros",
       "habl{amos}",
       "com{emos}",
       "viv{imos}"
      ],
      [
       "vosotros",
