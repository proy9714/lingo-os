  {
   "number": 4,
   "id": "ser-estar",
   "title": "ser vs. estar",
   "kind": "contrast",
   "level": "A1",
   "tags": [
    "ser",
    "estar",
    "to be"
   ],
   "rule": null,
   "text": "Some adjectives change meaning: **ser aburrido** (boring) / **estar aburrido** (bored); **ser listo** (clever) / **estar listo** (ready); **ser rico** (rich) / **estar rico** (tasty); **ser malo** (bad) / **estar malo** (ill).",
   "tables": [
    {
     "head": [
      "",
      "ser",
      "estar"
     ],
     "rows": [
      [
       "Forms",
       "soy, eres, es, somos, sois, son",
       "estoy, estás, está, estamos, estáis, están"
      ],
      [
       "Use",
       "what something is: identity, origin, job, character, time, material, where an event takes place",
       "how or where something is: state, mood, location, result"
      ],
      [
       "Examples",
       "Ella es médica. | She's a doctor. ;; Son las tres. | It's three o'clock.",
       "Estoy cansado. | I'm tired. ;; El banco está en la plaza. | The bank is on the square."
      ]
     ]
    }
   ],
   "after": null,
   "examples": [
    {
     "text": "Soy de India, pero estoy en Madrid.",
     "translation": "I'm from India, but I'm in Madrid.",
     "note": null,
     "reading": null
    },
    {
     "text": "La sopa está muy rica.",
     "translation": "The soup is delicious.",
     "note": "estar rico = tasty",
     "reading": null
    },
    {
     "text": "La fiesta es en mi casa.",
     "translation": "The party is at my place.",
     "note": "events take ser",
