       "لا + present",
       "doesn't (now, habit)",
       "لا أعرف | I don't know"
      ],
      [
       "لم + present (jussive)",
       "didn't",
       "لم أذهب | I didn't go"
      ],
      [
       "لن + present (subjunctive)",
       "won't",
       "لن أنسى | I won't forget"
      ],
      [
       "ليس",
       "isn't (sentences without a verb)",
       "ليس هنا | he isn't here"
      ],
      [
       "ما + past",
       "didn't (spoken, older style)",
       "ما رأيته | I didn't see him"
      ],
      [
       "لا + present (command)",
       "don't!",
       "لا تقلق | don't worry"
      ]
     ]
    }
