       "فَعَلَ (I)",
       "basic verb",
       "كتب | wrote"
      ],
      [
       "فاعِل",
       "the one who does",
       "كاتب | writer"
      ],
      [
       "مَفْعَل",
       "place",
       "مكتب | office, desk"
      ],
      [
       "مَفْعُول",
       "done (passive participle)",
       "مكتوب | written"
      ],
      [
       "فاعَلَ (III)",
       "do with someone",
       "كاتب | correspond with"
      ],
      [
       "اِسْتَفْعَلَ (X)",
       "seek, consider",
       "استكتب | ask to write"
      ]
     ]
    }
   ],
