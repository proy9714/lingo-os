       "أنتِ",
       "كتاب{ك} (-ki)"
      ],
      [
       "he / it",
       "هو",
       "كتاب{ه}"
      ],
      [
       "she / it",
       "هي",
       "كتاب{ها}"
      ],
      [
       "we",
       "نحن",
       "كتاب{نا}"
      ],
      [
       "you (pl.)",
       "أنتم",
       "كتاب{كم}"
      ],
      [
       "they",
       "هم",
       "كتاب{هم}"
      ]
     ]
    }
