       "কর{ো}",
       "কর{ছ}"
      ],
      [
       "আপনি / তিনি",
       "কর{েন}",
       "কর{ছেন}"
      ],
      [
       "সে / ও / তারা",
       "কর{ে}",
       "কর{ছে}"
      ]
     ]
    }
   ],
   "after": null,
