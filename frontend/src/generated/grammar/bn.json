      "Postposition",
      "Meaning",
      "Example"
     ],
     "rows": [
      [
       "জন্য",
       "for",
       "তোমার জন্য | for you"
      ],
      [
       "সঙ্গে / সাথে",
       "with",
       "বন্ধুর সঙ্গে | with a friend"
      ],
      [
       "থেকে",
       "from, since",
       "অফিস থেকে | from the office"
      ],
      [
       "কাছে",
       "near, to (a person)",
       "আমার কাছে | near me, with me"
      ],
      [
       "আগে / পরে",
       "before / after",
       "খাওয়ার পরে | after eating"
      ]
     ]
    }
   ],
   "after": null,
   "examples": [
